shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

; Allow build scripts to run for native modules
ignore-scripts=false
enable-pre-post-scripts=true

; Supply chain policies - allow esbuild and better-sqlite3 build scripts
; These packages need postinstall to generate platform binaries
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=better-sqlite3

; Node.js settings
node-linker=hoisted

; Chinese npm mirror for faster downloads
; npmmirror.com is the official mirror maintained by Taobao
registry=https://registry.npmmirror.com

; Network timeout (ms)
fetch-timeout=300000
fetch-retries=3
fetch-retry-mintime=5000
fetch-retry-maxtime=120000

; Package-specific registry overrides for common slow packages
; These ensure critical native binaries are downloaded from mirror
@puppeteer:registry=https://registry.npmmirror.com
@electron:registry=https://registry.npmmirror.com